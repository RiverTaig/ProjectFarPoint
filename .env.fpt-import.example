# Copy to .env.fpt-import. This file is used only by the Python importer.
# Supabase Dashboard > Connect > PostgreSQL URI (Session pooler works with IPv4).
# Replace the password placeholder with your database password, URL-encoded.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres
